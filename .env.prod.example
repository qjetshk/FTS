# Шаблоны Environment для сервисов Dokploy (deploy/dokploy/*.yml). Только плейсхолдеры — репо публичный.
# Секреты: openssl rand -hex 32. Сервисы front и xray переменных не требуют.

# ── back (deploy/dokploy/back.yml) ──
# база и пользователь в общем Postgres (pgvector, тот же контейнер, что у n8n) — создаются вручную
POSTGRES_HOST=easyfts-postgres-rk4quw-postgres-1
POSTGRES_USER=fts_user
POSTGRES_PASSWORD=
POSTGRES_DB=fts_db
# Redis — база Dokploy (Database → Redis): Internal Host и пароль из её карточки
REDIS_HOST=
REDIS_PASSWORD=
FRONTEND_URL=https://easyfts.ru
COOKIE_DOMAIN=.easyfts.ru
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
INTERNAL_API_KEY=
# 32 байта hex — тот же, что в dev, иначе старые XML не расшифруются
XML_ENCRYPTION_KEY=
# n8n — по dokploy-network по имени контейнера, снаружи не нужен
N8N_URL=http://easyfts-n8n-juqskn-n8n-1:5678
N8N_STATFORM_WEBHOOK_URL=http://easyfts-n8n-juqskn-n8n-1:5678/webhook/fts-xml-gen
# тот же секрет — в credential «JWT Auth account» в n8n
N8N_WEBHOOK_SECRET=
# отдельный ключ n8n (Settings → n8n API) для сторожа прогонов
N8N_API_KEY=
N8N_STATFORM_WORKFLOW_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# ── email-worker (deploy/dokploy/email-worker.yml) ──
REDIS_HOST=
REDIS_PASSWORD=
INTERNAL_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=easyfts <noreply@easyfts.ru>
