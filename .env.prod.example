# Шаблон Environment для compose-проекта Dokploy (docker-compose.prod.yml). Только плейсхолдеры — репо публичный.
# Секреты: openssl rand -hex 32

POSTGRES_USER=fts_user
POSTGRES_PASSWORD=
POSTGRES_DB=fts_db

# домены
FRONTEND_URL=https://easyfts.ru
COOKIE_DOMAIN=.easyfts.ru
NEXT_PUBLIC_API_URL=https://api.easyfts.ru/api
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
INTERNAL_API_KEY=
# 32 байта hex — тот же, что в dev, иначе старые XML не расшифруются
XML_ENCRYPTION_KEY=

# n8n — по общей сети dokploy-network (имя контейнера n8n), снаружи не нужен
N8N_URL=http://n8n:5678
N8N_STATFORM_WEBHOOK_URL=http://n8n:5678/webhook/fts-xml-gen
# тот же секрет — в credential «JWT Auth account» в n8n
N8N_WEBHOOK_SECRET=
# отдельный ключ n8n (Settings → n8n API) для сторожа прогонов
N8N_API_KEY=
N8N_STATFORM_WORKFLOW_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

RESEND_API_KEY=
EMAIL_FROM=easyfts <noreply@easyfts.ru>
